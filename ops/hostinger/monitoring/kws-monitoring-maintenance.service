[Unit]
Description=KWS beta monitoring retention policy
After=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/kws/monitoring/maintenance.py --apply
TimeoutStartSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kws-monitoring
MemoryMax=128M
CPUQuota=20%
StandardOutput=journal
StandardError=journal
