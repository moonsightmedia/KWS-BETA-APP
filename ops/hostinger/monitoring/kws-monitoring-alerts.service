[Unit]
Description=KWS grouped beta error alert outbox
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/kws/monitoring/alert_worker.py --apply
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kws-monitoring
MemoryMax=128M
CPUQuota=20%
StandardOutput=journal
StandardError=journal
